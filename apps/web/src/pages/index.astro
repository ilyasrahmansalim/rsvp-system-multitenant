---
import { getCollection } from 'astro:content';
import EventLayout from '../layouts/EventLayout.astro';
import { formatDate } from '../lib/format';

const events = (await getCollection('rsvp')).sort((a, b) => a.data.event_date.getTime() - b.data.event_date.getTime());
---

<EventLayout title="RSVP Event" description="Daftar event yang tersedia.">
  <main class="mx-auto w-full max-w-5xl px-4 py-12">
    <h1 class="text-4xl font-extrabold sm:text-5xl">Event yang sedang dibuka</h1>
    <p class="mt-3 max-w-prose text-base-content/70">Pilih event, daftar, lalu ambil tiket QR Anda di dashboard.</p>

    <div class="mt-10 grid gap-5 sm:grid-cols-2">
      {
        events.map((e) => (
          <a href={`/${e.id}`} data-theme={e.data.theme} class="card bg-base-100 shadow-md transition hover:shadow-lg focus-visible:outline focus-visible:outline-2 focus-visible:outline-primary">
            <div class="card-body">
              <h2 class="card-title">{e.data.title}</h2>
              <p class="text-sm text-base-content/70">{formatDate(e.data.event_date)} · {e.data.location}</p>
              <div class="card-actions mt-2">
                {e.data.has_assignment && <span class="badge badge-secondary badge-outline">Ada penugasan</span>}
                <span class="badge badge-ghost">/{e.id}</span>
              </div>
            </div>
          </a>
        ))
      }
    </div>
    <p class="mt-10 text-sm text-base-content/60">
      Admin: <a class="link" href="/admin/index.html">/admin</a>
    </p>
  </main>
</EventLayout>
