---
import { getCollection, type CollectionEntry } from 'astro:content';
import EventLayout from '../../layouts/EventLayout.astro';
import { formatDate, formatTime } from '../../lib/format';

export async function getStaticPaths() {
  const events = await getCollection('rsvp');
  return events.map((event) => ({ params: { nama_event: event.id }, props: { event } }));
}

interface Props {
  event: CollectionEntry<'rsvp'>;
}
const { event } = Astro.props;
const e = event.data;
const slug = event.id;
---

<EventLayout title={`Dashboard — ${e.title}`} theme={e.theme} slug={slug} eventTitle={e.title}>
  <main
    id="app"
    class="mx-auto w-full max-w-5xl px-4 py-10"
    data-slug={slug}
    data-event-id={e.event_id}
    data-event-title={e.title}
    data-spreadsheet-id={e.spreadsheet_id}
    data-has-assignment={String(e.has_assignment)}
  >
    <!-- Memuat -->
    <div id="state-loading" class="flex justify-center py-24" role="status" aria-live="polite">
      <span class="loading loading-spinner loading-lg"></span>
      <span class="sr-only">Memuat dashboard</span>
    </div>

    <div id="state-ready" class="hidden space-y-8">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <h1 class="text-3xl font-extrabold sm:text-4xl">Halo, <span id="user-greeting"></span></h1>
          <p class="mt-1 text-base-content/70">{e.title}</p>
        </div>
        <button id="btn-logout" type="button" class="btn btn-outline btn-sm">Keluar</button>
      </div>

      <div id="alert" role="alert" class="alert hidden"><span id="alert-text"></span></div>

      <div class="grid gap-6 lg:grid-cols-2">
        <!-- Akun & status -->
        <section class="card bg-base-100 shadow-md" aria-labelledby="akun">
          <div class="card-body">
            <h2 id="akun" class="card-title">Akun &amp; status pendaftaran</h2>
            <dl class="mt-2 grid grid-cols-[auto_1fr] gap-x-6 gap-y-2 text-sm">
              <dt class="text-base-content/60">Nama</dt><dd id="user-name" class="font-medium"></dd>
              <dt class="text-base-content/60">Email</dt><dd id="user-email" class="break-all font-medium"></dd>
              <dt class="text-base-content/60">WhatsApp</dt><dd id="user-phone" class="font-medium"></dd>
              <dt class="text-base-content/60">Status</dt><dd><span id="user-status" class="badge"></span></dd>
            </dl>
          </div>
        </section>

        <!-- Ringkasan acara -->
        <section class="card bg-base-100 shadow-md" aria-labelledby="acara">
          <div class="card-body">
            <h2 id="acara" class="card-title">Ringkasan acara</h2>
            <p class="text-sm text-base-content/70">{formatDate(e.event_date)}, {formatTime(e.event_date)} · {e.location}</p>
            {
              e.schedule.length > 0 && (
                <ul class="mt-2 space-y-2 text-sm">
                  {e.schedule.map((s) => (
                    <li class="flex gap-3">
                      <span class="badge badge-neutral shrink-0">{s.time}</span>
                      <span>{s.title}</span>
                    </li>
                  ))}
                </ul>
              )
            }
          </div>
        </section>
      </div>

      {
        e.has_assignment && (
          <section id="section-assignment" class="card bg-base-100 shadow-md" aria-labelledby="penugasan">
            <div class="card-body">
              <h2 id="penugasan" class="card-title">{e.assignment_title ?? 'Unggah penugasan'}</h2>
              {e.assignment_instructions && <p class="max-w-prose text-base-content/70">{e.assignment_instructions}</p>}

              <div id="assignment-done" class="alert alert-success mt-2 hidden">
                <span>Penugasan diterima: <strong id="assignment-name"></strong>. Anda bisa mengunggah ulang untuk mengganti file.</span>
              </div>

              <form id="form-assignment" class="mt-2 space-y-4" novalidate>
                <label class="form-control">
                  <span class="label-text mb-1">File penugasan (PDF, DOC, PPT, ZIP, PNG, JPG; maks. 5 MB)</span>
                  <input id="assignment-file" name="file" type="file" required accept=".pdf,.doc,.docx,.ppt,.pptx,.zip,.png,.jpg,.jpeg" class="file-input file-input-bordered w-full" />
                </label>
                <label class="form-control">
                  <span class="label-text mb-1">Catatan untuk panitia (opsional)</span>
                  <textarea name="note" rows="2" maxlength="500" class="textarea textarea-bordered"></textarea>
                </label>
                <button type="submit" class="btn btn-primary">
                  <span class="loading loading-spinner loading-sm hidden"></span>
                  <span class="label">Unggah penugasan</span>
                </button>
              </form>
            </div>
          </section>
        )
      }

      <!-- Tiket -->
      <section aria-labelledby="tiket">
        <h2 id="tiket" class="mb-4 text-2xl font-bold">E-ticket</h2>

        {
          e.has_assignment && (
            <div id="ticket-locked" class="card border border-dashed border-base-content/30 bg-base-100">
              <div class="card-body items-center text-center">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-base-content/50" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4" /></svg>
                <p class="text-lg font-semibold">Tiket Anda masih terkunci</p>
                <p class="max-w-prose text-base-content/70">Unggah penugasan di atas. QR Code muncul di sini begitu file Anda diterima.</p>
              </div>
            </div>
          )
        }

        <div id="ticket-unlocked" class="hidden">
          <div class="ticket-notch mx-auto flex max-w-2xl flex-col bg-base-100 shadow-lg sm:flex-row">
            <div class="flex flex-1 flex-col justify-between gap-6 p-6 sm:p-8">
              <div>
                <p class="text-sm text-base-content/60">Tiket peserta</p>
                <p class="mt-1 font-display text-2xl font-extrabold leading-tight">{e.title}</p>
                <p class="mt-3 text-sm">{formatDate(e.event_date)}</p>
                <p class="text-sm">{formatTime(e.event_date)} · {e.location}</p>
              </div>
              <div>
                <p class="text-sm text-base-content/60">Atas nama</p>
                <p id="ticket-name" class="text-lg font-semibold"></p>
                <p class="mt-2 font-mono text-sm tracking-wider" id="ticket-code"></p>
              </div>
            </div>
            <div class="flex flex-col items-center justify-center gap-3 border-t-2 border-dashed border-base-300 p-6 sm:w-64 sm:border-l-2 sm:border-t-0">
              <img id="ticket-qr" alt="QR Code tiket" width="220" height="220" class="rounded bg-white p-2" />
              <a id="ticket-download" download={`tiket-${e.event_id}.png`} class="btn btn-sm btn-outline">Unduh QR</a>
            </div>
          </div>
          <p class="mt-3 text-center text-sm text-base-content/60">Tunjukkan QR ini di meja registrasi.</p>
        </div>
      </section>
    </div>

    <!-- Modal konfirmasi keluar -->
    <dialog id="modal-logout" class="modal">
      <div class="modal-box">
        <h3 class="text-lg font-bold">Keluar dari akun?</h3>
        <p class="py-3">Anda perlu masuk lagi untuk melihat tiket.</p>
        <div class="modal-action">
          <form method="dialog"><button class="btn btn-ghost">Batal</button></form>
          <button id="btn-logout-confirm" type="button" class="btn btn-error">Keluar</button>
        </div>
      </div>
      <form method="dialog" class="modal-backdrop"><button aria-label="Tutup">tutup</button></form>
    </dialog>
  </main>
</EventLayout>

<script>
  import QRCode from 'qrcode';
  import { ticketPayload, type RsvpUser } from '@rsvp/shared';
  import { fetchMe, logout, submitAssignment, type EventCtx } from '../../lib/api';

  const root = document.getElementById('app') as HTMLElement;
  const ctx: EventCtx = {
    eventId: root.dataset.eventId!,
    spreadsheetId: root.dataset.spreadsheetId!,
    hasAssignment: root.dataset.hasAssignment === 'true',
  };
  const authUrl = `/${root.dataset.slug}/auth`;
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null;
  const setText = (id: string, text: string) => {
    const el = $(id);
    if (el) el.textContent = text;
  };

  const STATUS: Record<string, { label: string; cls: string }> = {
    registered: { label: 'Terdaftar', cls: 'badge-info' },
    assignment_submitted: { label: 'Penugasan terkirim', cls: 'badge-success' },
    checked_in: { label: 'Sudah check-in', cls: 'badge-primary' },
  };

  function showAlert(kind: 'error' | 'success', msg: string) {
    const box = $('alert')!;
    box.className = `alert ${kind === 'error' ? 'alert-error' : 'alert-success'}`;
    setText('alert-text', msg);
  }

  async function render(user: RsvpUser) {
    setText('user-greeting', user.name.split(' ')[0]);
    setText('user-name', user.name);
    setText('user-email', user.email);
    setText('user-phone', user.phone || '-');

    // Status: untuk event tanpa penugasan, tiket langsung aktif -> tampil "Terdaftar".
    const st = STATUS[user.status] ?? STATUS.registered;
    const badge = $('user-status')!;
    badge.textContent = st.label;
    badge.className = `badge ${st.cls}`;

    // Penugasan (section hanya ada di DOM jika has_assignment = true)
    if (ctx.hasAssignment && user.assignment_submitted_at) {
      $('assignment-done')?.classList.remove('hidden');
      setText('assignment-name', user.assignment_name);
    }

    // Tiket: terbuka bila server mengirim ticket_code (tidak dikirim selama terkunci)
    const unlocked = user.ticket_unlocked && !!user.ticket_code;
    $('ticket-locked')?.classList.toggle('hidden', unlocked);
    $('ticket-unlocked')!.classList.toggle('hidden', !unlocked);
    if (unlocked) {
      setText('ticket-name', user.name);
      setText('ticket-code', user.ticket_code);
      const url = await QRCode.toDataURL(ticketPayload(ctx.eventId, user.ticket_code), {
        width: 440,
        margin: 1,
        errorCorrectionLevel: 'M',
      });
      ($('ticket-qr') as HTMLImageElement).src = url;
      ($('ticket-download') as HTMLAnchorElement).href = url;
    }
  }

  // Logout
  const modal = $('modal-logout') as HTMLDialogElement;
  $('btn-logout')!.addEventListener('click', () => modal.showModal());
  $('btn-logout-confirm')!.addEventListener('click', async () => {
    await logout(ctx);
    location.assign(authUrl);
  });

  // Form penugasan
  const form = $('form-assignment') as HTMLFormElement | null;
  form?.addEventListener('submit', async (ev) => {
    ev.preventDefault();
    const file = ($('assignment-file') as HTMLInputElement).files?.[0];
    if (!file) return showAlert('error', 'Pilih file penugasan terlebih dahulu.');
    const btn = form.querySelector('button[type=submit]') as HTMLButtonElement;
    const spinner = btn.querySelector('.loading')!;
    btn.disabled = true;
    spinner.classList.remove('hidden');
    try {
      const note = String(new FormData(form).get('note') ?? '');
      const user = await submitAssignment(ctx, file, note);
      await render(user);
      form.reset();
      showAlert('success', 'Penugasan berhasil diunggah. Tiket QR Anda sudah aktif.');
    } catch (err) {
      showAlert('error', err instanceof Error ? err.message : 'Gagal mengunggah penugasan.');
    } finally {
      btn.disabled = false;
      spinner.classList.add('hidden');
    }
  });

  // Inisialisasi
  (async () => {
    try {
      const user = await fetchMe(ctx);
      if (!user) return location.replace(authUrl);
      await render(user);
      $('state-loading')!.classList.add('hidden');
      $('state-ready')!.classList.remove('hidden');
    } catch (err) {
      $('state-loading')!.classList.add('hidden');
      $('state-ready')!.classList.remove('hidden');
      showAlert('error', err instanceof Error ? err.message : 'Gagal memuat data.');
    }
  })();
</script>
