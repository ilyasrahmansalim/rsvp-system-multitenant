---
import EventLayout from '../layouts/EventLayout.astro';
---

<EventLayout title="Halaman tidak ditemukan">
  <main class="mx-auto flex w-full max-w-xl flex-col items-start gap-4 px-4 py-20">
    <h1 class="text-4xl font-extrabold">Halaman tidak ditemukan</h1>
    <p class="text-base-content/70">Alamat yang Anda buka tidak cocok dengan event mana pun. Periksa kembali tautan dari penyelenggara.</p>
    <a href="/" class="btn btn-primary">Lihat daftar event</a>
  </main>
</EventLayout>
